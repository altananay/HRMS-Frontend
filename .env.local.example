# Copy to .env.local. Never commit .env.local — it is gitignored.
#
# Nothing here is NEXT_PUBLIC_ on purpose: the browser never talks to the .NET API directly, so no
# API address or credential belongs in the client bundle. Everything below is read server-side only.

# The .NET API, reached from the Next.js server.
#
# https is what `dotnet run` serves by default. Node will not trust the ASP.NET development
# certificate unless you tell it to, so the everyday dev loop wants:
#
#     NODE_OPTIONS=--use-system-ca npm run dev
#
# Without that flag every BFF call fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE. The Playwright suite
# sidesteps it by running the API over plain http on 5129.
API_BASE_URL=https://localhost:7129

# Set false on http://localhost so the session cookies are actually sent; production leaves it true.
SESSION_COOKIE_SECURE=false

# This app's own address, used for canonical URLs, robots.txt and sitemap.xml. Optional — defaults to
# http://localhost:3000. Unlike the two above it never throws when missing.
SITE_URL=http://localhost:3000
